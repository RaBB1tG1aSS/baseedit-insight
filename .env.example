# ── Database ────────────────────────────────────────────────────────────────
# Absolute or relative path to the SQLite file used by BOTH the web app and the worker.
DATABASE_PATH=./data/baseedit.db

# ── App / scheduler ─────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Singapore
SCHEDULER_ENABLED=true
# Daily pipeline HH:mm (24h) in APP_TIMEZONE
DAILY_RUN_TIME=08:00
# Weekly report: day of week (0=Sunday) + time
WEEKLY_RUN_DAY=0
WEEKLY_RUN_TIME=18:00
WORKER_POLL_MS=3000

# ── AI provider ─────────────────────────────────────────────────────────────
# claude-cli  : uses your locally authenticated `claude` CLI (no extra key needed)
# anthropic   : direct Anthropic Messages API (requires ANTHROPIC_API_KEY)
AI_PROVIDER=claude-cli
AI_MODEL=
# Only used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Hard cap per AI call in USD (claude-cli only). Prevents runaway spend.
AI_MAX_BUDGET_USD=1.50

# ── Academic data sources ───────────────────────────────────────────────────
# NCBI asks for an e-mail and gives 10 req/s with a key (3 req/s without).
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
# OpenAlex polite pool
OPENALEX_MAILTO=you@example.com
# Optional
SEMANTIC_SCHOLAR_API_KEY=

# ── Ingestion policies ──────────────────────────────────────────────────────
MIN_ACCEPT_SCORE=60
MIN_TOPIC_RELEVANCE=8
MAX_CANDIDATES_PER_RUN=40
